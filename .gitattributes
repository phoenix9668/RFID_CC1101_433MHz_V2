# Auto detect text files and perform LF normalization.
* text=auto
# Immutable upstream snapshots must retain their original bytes on every OS.
Drivers/ADI/* -text
Drivers/PCG/* -text
Core/Startup/startup_stm32l051xx.s -text
PCB/RFID_CC1101_433MHz_V3.8/* -text
PCB/RFID_CC1101_433MHz_V3.8/*.pdf binary
# Replay evidence and hashed source files must survive checkout byte-for-byte.
Doc/ADXL362_Resampling_Validation/** -text
App/Src/resampler.c -text
App/Src/resampler_kernel.h -text
Tools/validate-resampling.py -text
Tools/behavior_acceptance.py -text
# ReportLab may emit ASCII-only PDFs; never apply text newline conversion.
output/pdf/ADXL362_25Hz_Supplier_Report.pdf binary
# The supplier report intentionally uses Markdown two-space line breaks.
Doc/ADXL362_25Hz_Investigation/README.md whitespace=-blank-at-eol

# Raw measurements and large replay data use LFS, without rewriting old history.
Doc/*.dsl filter=lfs diff=lfs merge=lfs -text
"Doc/Power Consumption Data/*.iotpl" filter=lfs diff=lfs merge=lfs -text
Doc/data/*.mp4 filter=lfs diff=lfs merge=lfs -text
Doc/data/*_result.csv filter=lfs diff=lfs merge=lfs -text
Doc/MATLAB/*.xlsx filter=lfs diff=lfs merge=lfs -text
Doc/MATLAB/**/*.xlsx filter=lfs diff=lfs merge=lfs -text

# Keep small historical analysis evidence in ordinary Git, byte-for-byte.
Doc/Paper/validation/*.csv -text
Doc/Paper/validation/*.json -text
Doc/Paper/validation/output/*.csv -text
Doc/Paper/validation/output/*.json -text
output/pdf/panting_algorithm_validation_report/*.pdf binary
